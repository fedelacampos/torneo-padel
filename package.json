{
  "name": "padel-torneos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-push.mjs && tsx prisma/setup.ts && next build",
    "start": "next start",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "reminders": "tsx scripts/reminders.ts",
    "local:schema": "mkdir -p prisma/local && sed -e 's/provider  = \"postgresql\"/provider = \"sqlite\"/' -e '/directUrl/d' prisma/schema.prisma > prisma/local/schema.prisma",
    "local:setup": "npm run local:schema && prisma db push --schema prisma/local/schema.prisma && tsx prisma/seed.ts",
    "local:build": "npm run local:schema && prisma generate --schema prisma/local/schema.prisma && next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@prisma/client": "6.19.2",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
