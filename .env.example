# --- Base de datos ---
# Producción (Supabase): Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Desarrollo local con SQLite (npm run local:setup): usar
# DATABASE_URL="file:./dev.db"

# --- Seguridad ---
SESSION_SECRET="una-clave-larga-y-aleatoria"

# --- Complejo inicial (se crea solo en la primera publicación) ---
COMPLEX_SLUG="micomplejo"
COMPLEX_NAME="Mi Complejo de Pádel"
ADMIN_PASSWORD="cambiar-esta-clave"
SEED_DEMO="1"

# --- URL pública (para los links de WhatsApp) ---
PUBLIC_URL="https://torneo-padel.vercel.app"

# --- WhatsApp Business Cloud API (ver docs/whatsapp-business.md) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_LANG="es_AR"
WHATSAPP_TEMPLATE_INSCRIPCION="nueva_inscripcion"   # aviso al organizador de cada inscripción
WHATSAPP_TEMPLATE="recordatorio_partido"            # recordatorio 1 hora antes del partido
CRON_SECRET=""
