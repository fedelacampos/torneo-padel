# Base de datos (SQLite para desarrollo; en producción usar Postgres, ej. Supabase)
DATABASE_URL="file:./dev.db"
# Clave para firmar las sesiones de administrador (cambiar por una larga y aleatoria)
SESSION_SECRET="cambiar-esta-clave"
# URL pública de la web (para los links de WhatsApp)
PUBLIC_URL="http://localhost:3000"
# Opcional: WhatsApp Business Cloud API (para envíos y recordatorios automáticos)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE="recordatorio_partido"
CRON_SECRET=""
